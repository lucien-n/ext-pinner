{
	"name": "[DEV] Pinner - Persisted pinned tabs",
	"description": "Organize your pinned tabs into named collections. Save, restore,  automatically load, import and export them whenever you need.",
	"version": "1.1.4",
	"manifest_version": 3,
	"action": {
		"default_popup": "index.html",
		"default_icon": "icon-dev.svg"
	},
	"permissions": [
		"storage",
		"tabs"
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"commands": {
		"load-collection": {
			"suggested_key": {
				"default": "Ctrl+Shift+L",
				"mac": "Command+Shift+L"
			},
			"description": "Loads the associated collection"
		}
	}
}